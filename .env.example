# PocketBase public API URL
VITE_POCKETBASE_URL=http://127.0.0.1:8090

# ==============================
# PocketBase
# ==============================
PB_URL=http://127.0.0.1:8090
PB_SUPERUSER_EMAIL=you@example.com
PB_SUPERUSER_PASSWORD=change_this

# ==============================
# Express API
# ==============================
API_PORT=3001
VITE_API_BASE_URL=http://127.0.0.1:3001

# ==============================
# Social sign-in (optional)
# ==============================
# Google + GitHub are PocketBase OAuth2 providers. Add the client IDs and
# secrets, then run: npm run setup:oauth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Telegram is not a PocketBase OAuth2 provider. The server signs people in with
# a bot handshake instead: create a bot with @BotFather and paste its token.
# Leave it blank to keep the Telegram button disabled.
TELEGRAM_BOT_TOKEN=

# ==============================
# Public calendar feed (optional)
# ==============================
# `npm run tunnel` starts cloudflared and writes the public URL to
# .runtime/public-base.json, which the API reads automatically.
TUNNEL_TARGET=
